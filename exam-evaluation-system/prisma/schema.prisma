model student_paper_results_openai {
  id             Int      @id @default(autoincrement())
  student_index  String
  module_code    String
  exam_year      Int
  exam_month     String
  total_marks    Float
  total_possible Float
  graded_at      DateTime @db.Timestamptz
  assessment_id  String

  @@unique([student_index, module_code, exam_year, exam_month, assessment_id])
}

model graded_student_answers_openai {
  id               Int      @id @default(autoincrement())
  student_index    String
  module_code      String
  exam_year        Int
  exam_month       String
  full_question_id String
  mark             Float
  max_marks        Float
  reason           String
  graded_at        DateTime @db.Timestamptz
  is_null_answer   Boolean
  assessment_id    String
  submission_id    String?

  @@unique([student_index, module_code, exam_year, exam_month, full_question_id, assessment_id])
}

model student_answers_gemini {
  student_index String
  module_code   String
  exam_year     Int
  exam_month    String
  answers       Json
  assessment_id String // NEW
  submission_id String // NEW
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([submission_id, student_index, module_code, exam_year, exam_month])
}

