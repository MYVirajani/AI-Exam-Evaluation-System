            '$2b$10$AZ7hxGAk3ShDd8PPJryQ9OxBQEy4d1CATvMUgdozxifSjtDIXrRmG',  -- Specified password hash
            'student' || i || '@example.com',
            '077' || LPAD((i*123456)::TEXT, 7, '0'),
            i || ' Main Street',
            'Galle',
            'Sri Lanka',
            NOW()
        );
        
        -- Insert into Student table
        INSERT INTO "Student" (
            user_id,
            registration_number,
            education_institute
        ) VALUES (
            user_id_val,
            reg_numbers[i],
            'Faculty of Engineering, University of Ruhuna'
        );
    END LOOP;
END $$;