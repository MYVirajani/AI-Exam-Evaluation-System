DO $$
DECLARE
    i INT;
    user_id_val UUID;
    first_names TEXT[] := ARRAY['John', 'Emma', 'Michael', 'Sophia', 'William', 'Olivia', 'James', 'Ava', 'Robert', 'Isabella', 'David', 'Mia', 'Joseph', 'Charlotte', 'Daniel', 'Amelia', 'Matthew', 'Harper', 'Andrew', 'Evelyn'];
    last_names TEXT[] := ARRAY['Smith', 'Johnson', 'Williams', 'Brown', 'Jones', 'Garcia', 'Miller', 'Davis', 'Rodriguez', 'Martinez', 'Hernandez', 'Lopez', 'Gonzalez', 'Wilson', 'Anderson', 'Thomas', 'Taylor', 'Moore', 'Jackson', 'Martin'];
    titles TEXT[] := ARRAY['Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms', 'Mr', 'Ms'];
