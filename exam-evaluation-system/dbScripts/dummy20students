    FOR i IN 1..20 LOOP
        -- Generate a UUID for each user
        user_id_val := gen_random_uuid();
        
        -- Insert into User table
        INSERT INTO "User" (
            user_id,
            first_name,
            last_name,
            title,
            role,
            username,
            password,
            email,
            phone_number,
            address,
            city,
            country,
            created_on
