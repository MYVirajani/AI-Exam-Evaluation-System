generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id           String   @id @default(uuid())
  first_name        String
  last_name         String
  title             String
  role              Role
  username          String   @unique
  password          String
  email             String   @unique
  address           String?
  phone_number      String
  country           String?
  city              String?
  profile_image_url String?
  created_on        DateTime @default(now())

  educator Educator?
  student  Student?
}

model Educator {
  official_email      String             @unique
  education_institute String
  user_id             String             @id
  user                User               @relation(fields: [user_id], references: [user_id])
  modules             Module[]
  question_grades     Question_Grade[]
  assessment_grades   Assessment_Grade[]
  assessments         Assessment[]
}

model Student {
  user_id             String            @id
  registration_number String            @unique
  education_institute String
  user                User              @relation(fields: [user_id], references: [user_id])
  enrollments         Enrollment[]
  submissions         Submission[]
  Quiz_Submission     Quiz_Submission[]
}

enum Role {
  admin
  educator
  student
}

model Module {
  module_id           String  @id
  module_code         String
  module_name         String
  semester            String
  education_institute String
  max_enrollments     Int
  learning_outcomes   String?
  enrollment_key      String?
  module_image_url    String?
  created_by          String

  educator    Educator     @relation(fields: [created_by], references: [user_id])
  assessments Assessment[]
  enrollments Enrollment[]
  lessons     Lesson[]
}

model Enrollment {
  enrollment_id       String @id @default(uuid())
  registration_number String
  module_id           String

  student Student @relation(fields: [registration_number], references: [registration_number])
  module  Module  @relation(fields: [module_id], references: [module_id])

  @@unique([registration_number, module_id])
}

model Lesson {
  lesson_id  String   @id @default(uuid())
  module_id  String
  title      String
  created_on DateTime @default(now())

  module    Module            @relation(fields: [module_id], references: [module_id])
  materials LectureMaterial[]
}

model LectureMaterial {
  material_id String   @id @default(uuid())
  lesson_id   String
  file_name   String?
  file_url    String
  uploaded_on DateTime @default(now())
  description String?

  lesson Lesson @relation(fields: [lesson_id], references: [lesson_id])
}

model Assessment {
  assessment_id     String         @id
  type              assessmentType
  title             String
  description       String
  instructions      String[]
  duration          Int
  deadline          DateTime
  module_id         String
  created_by        String
  total_marks       Decimal        @db.Decimal(4, 1)
  password          String? // For quiz access
  question_count    Int? // Number of questions to show (for quizzes)
  shuffle_questions Boolean        @default(false) // Whether to shuffle questions
  max_attempts      Int?

  module             Module              @relation(fields: [module_id], references: [module_id])
  educator           Educator            @relation(fields: [created_by], references: [user_id])
  question_paper     Question_Paper?
  model_answer_paper Model_Answer_Paper?
  marking_scheme     Marking_Scheme?
  submissions        Submission[]
  questions          Question[]
  Quiz_Submission    Quiz_Submission[]
}

model Question_Paper {
  question_paper_id String     @id
  assessment_id     String     @unique
  assessment        Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime
}

model Model_Answer_Paper {
  model_answer_paper_id String     @id
  assessment_id         String     @unique
  assessment            Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime
}

model Marking_Scheme {
  marking_scheme_id String     @id
  assessment_id     String     @unique
  assessment        Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime
}

enum assessmentType {
  endExam
  midExam
  assignment
  quiz
}

enum QuestionType {
  MCQ
  SHORT
  ESSAY
}

model Question {
  question_id        String       @id @default(cuid())
  assessment_id      String
  type               QuestionType
  question_number    String
  question           String
  model_answer       String
  mcq_answer_options String[]     @default([])
  marks_allowed      Decimal      @db.Decimal(4, 1)

  assessment  Assessment       @relation(fields: [assessment_id], references: [assessment_id])
  grades      Question_Grade[]
  Quiz_Answer Quiz_Answer[]
  Quiz_Grade  Quiz_Grade[]

  @@index([assessment_id])
}

model Submission {
  submission_id   String   @id
  assessment_id   String
  student_id      String
  file_url        String
  submission_time DateTime

  assessment       Assessment        @relation(fields: [assessment_id], references: [assessment_id])
  student          Student           @relation(fields: [student_id], references: [user_id])
  question_grades  Question_Grade[]
  assessment_grade Assessment_Grade?
}

model Quiz_Submission {
  id             String    @id @default(uuid())
  assessment_id  String
  student_id     String
  started_at     DateTime  @default(now())
  submitted_at   DateTime?
  ipAddress      String?
  device_info    String?
  total_marks    Decimal?  @db.Decimal(4, 1)
  obtained_marks Decimal?  @db.Decimal(4, 1)
  is_graded      Boolean   @default(false)

  assessment Assessment    @relation(fields: [assessment_id], references: [assessment_id])
  student    Student       @relation(fields: [student_id], references: [user_id])
  answers    Quiz_Answer[]
  grades     Quiz_Grade[]

  @@index([assessment_id])
  @@index([student_id])
}

model Quiz_Answer {
  submission_id  String
  question_id    String
  student_answer String
  is_correct     Boolean?
  marks_awarded  Decimal?  @db.Decimal(4, 1)
  graded_at      DateTime?
  feedback       String?

  submission Quiz_Submission @relation(fields: [submission_id], references: [id])
  question   Question        @relation(fields: [question_id], references: [question_id])

  @@id([submission_id, question_id]) // Composite primary key
  @@index([submission_id])
  @@index([question_id])
}

model Quiz_Grade {
  submission_id String
  question_id   String
  marks_awarded Decimal  @db.Decimal(4, 1)
  max_marks     Decimal  @db.Decimal(4, 1)
  feedback      String?
  graded_at     DateTime @default(now())
  auto_graded   Boolean  @default(true)

  submission Quiz_Submission @relation(fields: [submission_id], references: [id])
  question   Question        @relation(fields: [question_id], references: [question_id])

  @@id([submission_id, question_id]) // Composite primary key
}

model Question_Grade {
  q_grade_id    String   @id
  question_id   String
  submission_id String
  marks_awarded Decimal  @db.Decimal(4, 1)
  grading_time  DateTime
  auto_graded   Boolean
  feedback      String
  educator_id   String?
  model_id      String?

  question         Question          @relation(fields: [question_id], references: [question_id])
  submission       Submission        @relation(fields: [submission_id], references: [submission_id])
  educator         Educator?         @relation(fields: [educator_id], references: [user_id])
  evaluation_model Evaluation_Model? @relation(fields: [model_id], references: [model_id])
}

model Assessment_Grade {
  grade_id      String   @id
  submission_id String   @unique
  total_marks   Decimal  @db.Decimal(4, 1)
  marks_awarded Decimal  @db.Decimal(4, 1)
  feedback      String
  grading_time  DateTime
  auto_graded   Boolean
  educator_id   String?
  model_id      String?

  submission       Submission        @relation(fields: [submission_id], references: [submission_id])
  educator         Educator?         @relation(fields: [educator_id], references: [user_id])
  evaluation_model Evaluation_Model? @relation(fields: [model_id], references: [model_id])
}

model Evaluation_Model {
  model_id        String @id
  model_name      String
  pricing_plan_id String

  pricing_plan      Pricing_Plan       @relation(fields: [pricing_plan_id], references: [pricing_plan_id])
  question_grades   Question_Grade[]
  assessment_grades Assessment_Grade[]
}

model Pricing_Plan {
  pricing_plan_id String  @id
  name            String
  duration        Int
  price           Decimal @db.Decimal(6, 1)
  description     String
  payment_method  String

  evaluation_models Evaluation_Model[]
}
