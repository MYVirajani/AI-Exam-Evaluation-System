generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id           String   @id @default(uuid())
  first_name        String
  last_name         String
  title             String
  role              Role
  username          String   @unique
  password          String
  email             String   @unique
  address           String?
  phone_number      String
  country           String?
  city              String?
  profile_image_url String?
  created_on        DateTime @default(now()) @db.Timestamptz(6)

  educator Educator?
  student  Student?
}

model Educator {
  official_email      String             @unique
  education_institute String
  user_id             String             @id
  user                User               @relation(fields: [user_id], references: [user_id])
  modules             Module[]
  question_grades     Question_Grade[]
  assessment_grades   Assessment_Grade[]
  assessments         Assessment[]
}

model Student {
  user_id             String       @id
  registration_number String       @unique
  education_institute String
  user                User         @relation(fields: [user_id], references: [user_id])
  enrollments         Enrollment[]
  submissions         Submission[]
}

enum Role {
  admin
  educator
  student
}

model Module {
  module_id           String   @id
  module_code         String
  module_name         String
  semester            String
  education_institute String
  max_enrollments     Int
  learning_outcomes   String?
  enrollment_key      String?
  module_image_url    String?
  created_by          String
  created_on          DateTime @default(now()) @db.Timestamptz(6)

  educator    Educator     @relation(fields: [created_by], references: [user_id])
  assessments Assessment[]
  enrollments Enrollment[]
  lessons     Lesson[]
}

model Enrollment {
  enrollment_id       String   @id @default(uuid())
  registration_number String
  module_id           String
  enrolled_on         DateTime @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [registration_number], references: [registration_number])
  module  Module  @relation(fields: [module_id], references: [module_id])

  @@unique([registration_number, module_id])
}

model Lesson {
  lesson_id  String   @id @default(uuid())
  module_id  String
  title      String
  created_on DateTime @default(now()) @db.Timestamptz(6)

  module    Module            @relation(fields: [module_id], references: [module_id])
  materials LectureMaterial[]
}

model LectureMaterial {
  material_id String   @id @default(uuid())
  lesson_id   String
  file_name   String?
  file_url    String
  uploaded_on DateTime @default(now()) @db.Timestamptz(6)
  description String?

  lesson Lesson @relation(fields: [lesson_id], references: [lesson_id])
}

model Assessment {
  assessment_id     String         @id
  module_id         String
  created_by        String
  created_on        DateTime       @default(now()) @db.Timestamptz(6)
  type              assessmentType
  title             String
  description       String
  instructions      String[]
  duration          Int?
  deadline          DateTime       @db.Timestamptz(6)
  open_at           DateTime?      @db.Timestamptz(6)
  close_at          DateTime?      @db.Timestamptz(6)
  total_marks       Decimal?       @db.Decimal(5, 2) //total marks calculated by all questions of assessment
  max_marks         Decimal?       @db.Decimal(5, 2) //max marks a student can allocate by assessment
  password          String? // For quiz access
  question_count    Int? // Number of questions to show (for quizzes)
  shuffle_questions Boolean        @default(false) // Whether to shuffle questions
  max_attempts      Int?
  auto_grade        Boolean        @default(false)

  module             Module              @relation(fields: [module_id], references: [module_id])
  educator           Educator            @relation(fields: [created_by], references: [user_id])
  question_paper     Question_Paper?
  model_answer_paper Model_Answer_Paper?
  marking_scheme     Marking_Scheme?
  submissions        Submission[]
  questions          Question[]
}

model Question_Paper {
  question_paper_id String     @id
  assessment_id     String     @unique
  assessment        Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime @default(now()) @db.Timestamptz(6)
}

model Model_Answer_Paper {
  model_answer_paper_id String     @id
  assessment_id         String     @unique
  assessment            Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime @default(now()) @db.Timestamptz(6)
}

model Marking_Scheme {
  marking_scheme_id String     @id
  assessment_id     String     @unique
  assessment        Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime @default(now()) @db.Timestamptz(6)
}

enum assessmentType {
  endExam
  midExam
  assignment
  quiz
}

enum QuestionType {
  MCQ
  SHORT
  ESSAY
}

model Question {
  question_id        String       @id @default(cuid())
  assessment_id      String
  type               QuestionType
  created_on         DateTime     @default(now()) @db.Timestamptz(6)
  question_number    String
  question           String
  model_answer       String
  mcq_answer_options String[]     @default([])
  marks_allowed      Decimal      @db.Decimal(5, 2)

  assessment     Assessment       @relation(fields: [assessment_id], references: [assessment_id])
  grades         Question_Grade[]
  student_answer Student_Answer[]

  @@index([assessment_id])
}

enum SubmissionType {
  DOCUMENT
  ONLINE
}

model Submission {
  submission_id       String         @id @default(uuid())
  student_id          String
  assessment_id       String
  type                SubmissionType
  submission_start_at DateTime       @default(now()) @db.Timestamptz(6)
  submission_end_at   DateTime?      @db.Timestamptz(6)
  file_url            String? // for DOCUMENT
  ip_address          String? // for ONLINE
  device_info         String? // for ONLINE
  // total_marks     Decimal?       @db.Decimal(5, 2)
  // obtained_marks  Decimal?       @db.Decimal(5, 2)
  is_graded           Boolean        @default(false)

  is_handwritten       Boolean @default(false)
  handwritten_file_url String?

  student    Student           @relation(fields: [student_id], references: [user_id])
  assessment Assessment        @relation(fields: [assessment_id], references: [assessment_id])
  answers    Student_Answer[]
  grade      Assessment_Grade?
  q_grades   Question_Grade[]

  @@index([assessment_id])
  @@index([student_id])
}

model Student_Answer {
  submission_id  String
  question_id    String
  student_answer String
  submitted_on   DateTime  @default(now()) @db.Timestamptz(6)
  is_correct     Boolean?
  marks_awarded  Decimal?  @db.Decimal(5, 2)
  graded_at      DateTime? @db.Timestamptz(6)
  feedback       String?

  submission Submission @relation(fields: [submission_id], references: [submission_id])
  question   Question   @relation(fields: [question_id], references: [question_id])

  @@id([submission_id, question_id]) // Composite primary key
  @@index([submission_id])
  @@index([question_id])
}

model Question_Grade {
  question_id      String
  submission_id    String
  marks_awarded    Decimal  @db.Decimal(5, 2)
  max_marks        Decimal  @db.Decimal(5, 2)
  graded_at        DateTime @default(now()) @db.Timestamptz(6)
  grading_duration Decimal  @db.Decimal(6, 2)
  auto_graded      Boolean
  feedback         String?
  educator_id      String?
  model_id         String?

  question         Question          @relation(fields: [question_id], references: [question_id])
  submission       Submission        @relation(fields: [submission_id], references: [submission_id])
  educator         Educator?         @relation(fields: [educator_id], references: [user_id])
  evaluation_model Evaluation_Model? @relation(fields: [model_id], references: [model_id])

  @@id([submission_id, question_id])
  @@index([educator_id])
  @@index([model_id])
}

model Assessment_Grade {
  grade_id      String   @id
  submission_id String   @unique
  max_marks     Decimal  @db.Decimal(5, 2)
  marks_awarded Decimal  @db.Decimal(5, 2)
  feedback      String
  graded_at     DateTime @default(now()) @db.Timestamptz(6)
  auto_graded   Boolean
  educator_id   String?
  model_id      String?

  submission       Submission        @relation(fields: [submission_id], references: [submission_id])
  educator         Educator?         @relation(fields: [educator_id], references: [user_id])
  evaluation_model Evaluation_Model? @relation(fields: [model_id], references: [model_id])
}

model Evaluation_Model {
  model_id        String @id
  model_name      String
  pricing_plan_id String

  pricing_plan      Pricing_Plan       @relation(fields: [pricing_plan_id], references: [pricing_plan_id])
  question_grades   Question_Grade[]
  assessment_grades Assessment_Grade[]
}

model Pricing_Plan {
  pricing_plan_id String   @id
  name            String
  duration        Int
  price           Decimal  @db.Decimal(9, 3)
  description     String
  payment_method  String
  created_on      DateTime @default(now()) @db.Timestamptz(6)

  evaluation_models Evaluation_Model[]
}

model student_answers_openai {
  student_index String
  module_code   String
  exam_year     Int
  exam_month    String
  answers       Json
  assessment_id String // NEW
  submission_id String // NEW
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([submission_id, student_index, module_code, exam_year, exam_month])
}

