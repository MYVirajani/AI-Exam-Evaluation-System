generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id           String   @id @default(uuid())
  first_name        String
  last_name         String
  title             String
  role              Role
  username          String   @unique
  password          String
  email             String   @unique
  address           String?
  phone_number      String
  country           String?
  city              String?
  profile_image_url String?
  created_on        DateTime @default(now()) @db.Timestamptz(6)

  educator Educator?
  student  Student?
}

model Educator {
  user_id             String @id
  official_email      String @unique
  education_institute String

  user             User               @relation(fields: [user_id], references: [user_id])
  modules          Module[]
  assessments      Assessment[]
  subscriptions    Subscription[]
  Lesson           Lesson[]
  Lecture_Material Lecture_Material[]
}

model Student {
  user_id             String       @id
  registration_number String       @unique
  education_institute String
  user                User         @relation(fields: [user_id], references: [user_id])
  enrollments         Enrollment[]
  submissions         Submission[]
}

enum Role {
  admin
  educator
  student
}

enum AvailabilityStatus {
  draft // not visible to students yet
  active // visible and available
  expired // deadline passed (system can auto-update to this)
  archived // hidden manually by admin/educator
}

model Module {
  module_id           String             @id @default(uuid())
  module_code         String
  module_name         String
  semester            String
  education_institute String
  max_enrollments     Int
  learning_outcomes   String?
  enrollment_key      String?
  module_image_url    String?
  created_by          String
  created_on          DateTime           @default(now()) @db.Timestamptz(6)
  last_updated_at     DateTime           @default(now()) @db.Timestamptz(6)
  status              AvailabilityStatus @default(active)

  educator    Educator     @relation(fields: [created_by], references: [user_id])
  assessments Assessment[]
  enrollments Enrollment[]
  lessons     Lesson[]
}

model Enrollment {
  enrollment_id       String   @id @default(uuid())
  registration_number String
  module_id           String
  enrolled_on         DateTime @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [registration_number], references: [registration_number])
  module  Module  @relation(fields: [module_id], references: [module_id])

  @@unique([registration_number, module_id])
}

model Lesson {
  lesson_id  String   @id @default(uuid())
  module_id  String
  title      String
  created_by String?
  created_on DateTime @default(now()) @db.Timestamptz(6)
  updated_on DateTime @default(now()) @db.Timestamptz(6)

  module   Module    @relation(fields: [module_id], references: [module_id])
  educator Educator? @relation(fields: [created_by], references: [user_id])

  materials Lecture_Material[]
}

model Lecture_Material {
  id                       String   @id @default(uuid())
  lesson_id                String
  file_name                String?
  file_url                 String
  media_extracted_file_url String?
  created_by               String?
  created_on               DateTime @default(now()) @db.Timestamptz(6)
  updated_on               DateTime @default(now()) @db.Timestamptz(6)
  description              String?

  lesson   Lesson    @relation(fields: [lesson_id], references: [lesson_id])
  educator Educator? @relation(fields: [created_by], references: [user_id])

  lecture_material_media Lecture_Material_Media[]
}

model Lecture_Material_Media {
  id                  String   @id @default(uuid())
  model_id            String?
  lecture_material_id String
  media_url           String
  media_summary       String?
  created_on          DateTime @default(now()) @db.Timestamptz(6)
  updated_on          DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  lecture_material Lecture_Material  @relation(fields: [lecture_material_id], references: [id])
  evaluation_model Evaluation_Model? @relation(fields: [model_id], references: [id])

  @@index([lecture_material_id])
  @@index([model_id])
}

/**
 * model lecture_material_embedding {
 * id                  String   @id @default(uuid())
 * lecture_material_id String
 * chunk_index         Int
 * content             String?
 * embedding           Bytes    @db.Vector(1536)
 * model_id            String
 * created_on          DateTime @default(now()) @db.Timestamptz(6)
 * evaluation_model Evaluation_Model @relation(fields: [model_id], references: [id])
 * lecture_material Lecture_Material @relation(fields: [lecture_material_id], references: [id])
 * @@unique([lecture_material_id, chunk_index])
 * }
 */

enum assessmentType {
  endExam
  midExam
  assignment
  quiz
}

enum QuestionType {
  None
  MCQ
  SHORT
  ESSAY
  LIST
  GRAPH
  DIAGRAM
  TABLE
}

model Assessment {
  assessment_id             String             @id @default(uuid())
  module_id                 String
  created_by                String
  created_on                DateTime           @default(now()) @db.Timestamptz(6)
  updated_on                DateTime           @default(now()) @db.Timestamptz(6)
  type                      assessmentType
  title                     String
  description               String
  instructions              String[]
  duration                  Int?
  deadline                  DateTime           @db.Timestamptz(6)
  open_at                   DateTime?          @db.Timestamptz(6)
  close_at                  DateTime?          @db.Timestamptz(6)
  total_marks               Decimal?           @db.Decimal(5, 2)
  max_marks                 Decimal?           @db.Decimal(5, 2)
  model_id                  String? // optional FK
  password                  String?
  shuffle_questions         Boolean            @default(false)
  max_attempts              Int?
  auto_grade                Boolean            @default(false)
  back_navigation           Boolean            @default(true)
  case_sensitive_evaluation Boolean            @default(false)
  status                    AvailabilityStatus @default(active)

  module             Module               @relation(fields: [module_id], references: [module_id])
  educator           Educator             @relation(fields: [created_by], references: [user_id])
  evaluation_model   Evaluation_Model?    @relation(fields: [model_id], references: [id]) // FIXED
  question_paper     Question_Paper?
  model_answer_paper Model_Answer_Paper?
  marking_scheme     Marking_Scheme?
  submissions        Submission[]
  questions          Question[]
  Assessment_Grading Assessment_Grading[]
  Assessment_Grade   Assessment_Grade[]
}

model Question_Paper {
  question_paper_id String     @id @default(uuid())
  assessment_id     String     @unique
  assessment        Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime @default(now()) @db.Timestamptz(6)
  updated_on DateTime @default(now()) @db.Timestamptz(6)
}

model Model_Answer_Paper {
  id                       String   @id @default(uuid())
  assessment_id            String   @unique
  file_url                 String
  media_extracted_file_url String?
  created_on               DateTime @default(now()) @db.Timestamptz(6)
  updated_on               DateTime @default(now()) @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessment_id], references: [assessment_id])
  questions  Question[]
}

model Question {
  id                    String       @id @default(uuid())
  model_id              String
  assessment_id         String
  model_answer_paper_id String
  type                  QuestionType
  question_number       String
  question_text         String
  answer_text           String?
  mcq_answer_options    String[]     @default([])
  guideline_text        String
  max_marks             Int
  created_on            DateTime     @default(now()) @db.Timestamptz(6)
  updated_on            DateTime     @default(now()) @db.Timestamptz(6)

  // Relations
  evaluation_model   Evaluation_Model   @relation(fields: [model_id], references: [id])
  model_answer_paper Model_Answer_Paper @relation(fields: [model_answer_paper_id], references: [id])
  assessment         Assessment?        @relation(fields: [assessment_id], references: [assessment_id])
  media              Question_Media[]
  grading_results    Grading_Results[]

  @@index([assessment_id])
  @@index([model_answer_paper_id])
  @@index([model_id])
}

model Question_Media {
  id            String   @id @default(uuid())
  model_id      String
  question_id   String
  media_url     String
  media_summary String?
  created_on    DateTime @default(now()) @db.Timestamptz(6)
  updated_on    DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  question         Question         @relation(fields: [question_id], references: [id])
  evaluation_model Evaluation_Model @relation(fields: [model_id], references: [id])

  @@index([question_id])
  @@index([model_id])
}

model Marking_Scheme {
  marking_scheme_id String     @id @default(uuid())
  assessment_id     String     @unique
  assessment        Assessment @relation(fields: [assessment_id], references: [assessment_id])

  file_url   String
  created_on DateTime @default(now()) @db.Timestamptz(6)
}

enum SubmissionType {
  DOCUMENT
  ONLINE
}

model Submission {
  submission_id            String         @id @default(uuid())
  student_id               String
  assessment_id            String
  type                     SubmissionType
  submission_start_at      DateTime       @default(now()) @db.Timestamptz(6)
  submission_end_at        DateTime?      @db.Timestamptz(6)
  file_url                 String? // for DOCUMENT
  media_extracted_file_url String?
  ip_address               String? // for ONLINE
  device_info              String? // for ONLINE
  student_score            Decimal?       @db.Decimal(5, 2)
  is_graded                Boolean        @default(false)

  is_handwritten       Boolean @default(false)
  handwritten_file_url String?

  student          Student            @relation(fields: [student_id], references: [user_id])
  assessment       Assessment         @relation(fields: [assessment_id], references: [assessment_id])
  answers          Student_Answer[]
  grading_results  Grading_Results[]
  assessment_grade Assessment_Grade[]

  @@index([assessment_id])
  @@index([student_id])
}

model Student_Answer {
  id              String    @id @default(uuid())
  submission_id   String
  model_id        String
  question_number String
  answer_text     String
  created_on      DateTime  @default(now()) @db.Timestamptz(6)
  updated_on      DateTime  @default(now()) @db.Timestamptz(6)
  score           Decimal?  @db.Decimal(5, 2)
  feedback        String?
  graded_at       DateTime? @db.Timestamptz(6)

  // Relations
  submission       Submission             @relation(fields: [submission_id], references: [submission_id])
  evaluation_model Evaluation_Model       @relation(fields: [model_id], references: [id])
  media            Student_Answer_Media[]
  Grading_Results  Grading_Results[]

  @@index([submission_id])
  @@index([model_id])
}

model Student_Answer_Media {
  id                String   @id @default(uuid())
  model_id          String
  student_answer_id String
  media_url         String
  media_summary     String?
  created_on        DateTime @default(now()) @db.Timestamptz(6)
  updated_on        DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  student_answer   Student_Answer   @relation(fields: [student_answer_id], references: [id])
  evaluation_model Evaluation_Model @relation(fields: [model_id], references: [id])

  @@index([student_answer_id])
  @@index([model_id])
}

model Assessment_Grading {
  id               String   @id @default(uuid())
  assessment_id    String
  model_id         String
  started_at       DateTime @default(now()) @db.Timestamptz(6)
  ended_at         DateTime @default(now()) @db.Timestamptz(6)
  submission_count Int?
  questions_count  Int?

  // Relations
  evaluation_model Evaluation_Model @relation(fields: [model_id], references: [id])
  assessment       Assessment       @relation(fields: [assessment_id], references: [assessment_id])

  @@index([assessment_id])
  @@index([model_id])
}

model Evaluation_Model {
  id              String   @id @default(uuid())
  model_name      String   @unique
  provider        String
  chat_model      String?
  temperature     Float    @default(0.0)
  embedding_model String
  description     String?
  created_on      DateTime @default(now()) @db.Timestamptz(6)

  // Back-relations
  questions            Question[]
  Question_media       Question_Media[]
  student_answers      Student_Answer[]
  student_answer_media Student_Answer_Media[]

  pricing_plans          Pricing_Plan[]
  lecture_material_media Lecture_Material_Media[]
  Assessment_Grading     Assessment_Grading[]
  grading_results        Grading_Results[]
  assessment_grade       Assessment_Grade[]
  Assessment             Assessment[]
}

model Pricing_Plan {
  pricing_plan_id   String   @id @default(uuid())
  name              String
  billing_period    String
  price             Decimal  @db.Decimal(9, 2)
  description       String?
  features          String[]
  stripe_price_id   String   @unique
  stripe_product_id String
  created_on        DateTime @default(now()) @db.Timestamptz(6)

  evaluation_model Evaluation_Model @relation(fields: [model_id], references: [id], onDelete: Cascade)
  model_id         String
  subscriptions    Subscription[]
}

model Subscription {
  subscription_id        String             @id @default(uuid())
  status                 SubscriptionStatus @default(INCOMPLETE)
  start_date             DateTime           @default(now()) @db.Timestamptz(6)
  end_date               DateTime?
  stripe_customer_id     String?
  stripe_subscription_id String?

  // link to Pricing Plan
  pricing_plan    Pricing_Plan @relation(fields: [pricing_plan_id], references: [pricing_plan_id])
  pricing_plan_id String

  // link to Educator
  educator    Educator @relation(fields: [educator_id], references: [user_id])
  educator_id String
}

enum SubscriptionStatus {
  ACTIVE // Subscription is currently active
  CANCELED // Subscription was canceled by educator or admin
  PAST_DUE // Payment failed or overdue
  INCOMPLETE // Payment not completed yet
  TRIALING // Trial period before billing starts
  FAILED
}

model Grading_Results {
  id                String   @id @default(uuid())
  model_id          String
  submission_id     String
  student_answer_id String
  question_id       String?
  question_number   String?
  score             Decimal? @db.Decimal(5, 2)
  max_marks         Decimal? @db.Decimal(5, 2)
  feedback          String?
  grading_method    String?
  similarity_score  Decimal? @db.Decimal(5, 4)
  context_used      String?
  created_on        DateTime @default(now()) @db.Timestamptz(6)
  updated_on        DateTime @default(now()) @db.Timestamptz(6)

  evaluation_model Evaluation_Model @relation(fields: [model_id], references: [id])
  submission       Submission       @relation(fields: [submission_id], references: [submission_id])
  student_answer   Student_Answer   @relation(fields: [student_answer_id], references: [id])
  Question         Question?        @relation(fields: [question_id], references: [id])

  @@unique([model_id, submission_id, student_answer_id])
  @@index([model_id])
  @@index([submission_id])
  @@index([student_answer_id])
}

model Assessment_Grade {
  id            String   @id @default(uuid())
  model_id      String
  submission_id String
  assessment_id String
  score         Decimal? @db.Decimal(5, 2)
  max_marks     Decimal? @db.Decimal(5, 2)
  created_on    DateTime @default(now()) @db.Timestamptz(6)
  updated_on    DateTime @default(now()) @db.Timestamptz(6)

  evaluation_model Evaluation_Model @relation(fields: [model_id], references: [id])
  assessment       Assessment       @relation(fields: [assessment_id], references: [assessment_id])
  submission       Submission       @relation(fields: [submission_id], references: [submission_id])
}
